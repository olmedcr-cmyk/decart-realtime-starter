# Your permanent Decart API key. Server-side only: never prefix it with VITE_.
# Get one at https://platform.decart.ai
DECART_API_KEY=

# Comma-separated origins allowed to request tokens. Leave empty for local dev,
# set it to your public URL in production, e.g. https://mirror.example.com
ALLOWED_ORIGINS=

# Hard cap for a single realtime session, in seconds. Protects your credits.
MAX_SESSION_SECONDS=120

# Port for `npm start`.
PORT=8787
